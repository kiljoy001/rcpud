#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <stdarg.h>
#include <sched.h>
#include <string.h>

char *argv0 = "rcpud";

void setmalloctag(void *v, unsigned long pc) {}
void setrealloctag(void *v, unsigned long pc) {}

int sysopen(const char *path, int mode) { return open(path, mode); }
int sysclose(int fd) { return close(fd); }
long sysread(int fd, void *buf, long n) { return read(fd, buf, n); }
long syswrite(int fd, const void *buf, long n) { return write(fd, buf, n); }
int sysgetpid(void) { return getpid(); }
void osyield(void) { sched_yield(); }
void osmsleep(unsigned long ms) { usleep(ms * 1000); }

void iprint(const char *fmt, ...) {
    va_list args;
    va_start(args, fmt);
    vfprintf(stderr, fmt, args);
    va_end(args);
}

int __errfmt(void *f, void *a) { return 0; }
void qlock(void *l) {}
void qunlock(void *l) {}

void werrstr(char *fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    vfprintf(stderr, fmt, ap);
    fprintf(stderr, "\n");
    va_end(ap);
}

int errstr(char *buf, int len) {
    strncpy(buf, "error", len);
    return 0;
}

int print(char *fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    int n = vprintf(fmt, ap);
    va_end(ap);
    return n;
}

int fprint(int fd, char *fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    int n = vfprintf(fd == 2 ? stderr : stdout, fmt, ap);
    va_end(ap);
    return n;
}

