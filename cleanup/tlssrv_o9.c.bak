#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <stdio.h>
#include <stdarg.h>
#include <sys/types.h>

// missing Plan 9 basic types for Linux
typedef uint8_t uchar;
typedef uint16_t ushort;
typedef int64_t vlong;
typedef uint64_t uvlong;
typedef uint32_t u32int;
typedef uint64_t u64int;

typedef struct Fmt Fmt;

#include "/home/scott/Repo/go-dp9ik/drawterm/include/auth.h"
#include "/home/scott/Repo/go-dp9ik/drawterm/include/libsec.h"

// Forward declarations for functions in drawterm libs
extern void* mallocz(unsigned long, int);
extern AuthInfo* auth_proxy(int, AuthGetkey*, char*, ...);
extern int tlsServer(int, TLSconn*);
extern PEMChain* readcertchain(char*);

static int reporter(char *fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    vfprintf(stderr, fmt, ap);
    fprintf(stderr, "\n");
    va_end(ap);
    return 0;
}

int main(int argc, char **argv) {
    char *keyspec = "";
    char *cert = NULL;
    int auth = 0;
    int debug = 0;

    int opt;
    while ((opt = getopt(argc, argv, "aAk:c:D")) != -1) {
        switch (opt) {
        case 'a': auth = 1; break;
        case 'A': auth = 2; break;
        case 'k': keyspec = optarg; break;
        case 'c': cert = optarg; break;
        case 'D': debug = 1; break;
        default: fprintf(stderr, "Usage: %s [-aA] [-k keyspec] [-c cert] cmd [args...]\n", argv[0]); exit(1);
        }
    }

    if (optind >= argc) {
        fprintf(stderr, "Expected command after options\n");
        exit(1);
    }

    TLSconn *conn = mallocz(sizeof(TLSconn), 1);
    
    if (auth) {
        // Use FD 0 (stdin) for authentication handshake
        AuthInfo *ai = auth_proxy(0, NULL, "proto=p9any role=server %s", keyspec);
        if (ai == NULL) {
            fprintf(stderr, "auth_proxy failed\n");
            exit(1);
        }
        conn->pskID = "p9secret";
        conn->psk = (unsigned char*)ai->secret;
        conn->psklen = ai->nsecret;
    }

    if (cert) {
        conn->chain = readcertchain(cert);
        if (conn->chain) {
            conn->cert = conn->chain->pem;
            conn->certlen = conn->chain->pemlen;
        }
    }

    if (debug) conn->trace = reporter;

    int fd = tlsServer(0, conn);
    if (fd < 0) {
        fprintf(stderr, "tlsServer failed\n");
        exit(1);
    }

    dup2(fd, 0);
    dup2(fd, 1);
    if (fd > 1) close(fd);

    execvp(argv[optind], &argv[optind]);
    perror("exec failed");
    return 1;
}
